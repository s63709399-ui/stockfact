# IMPORTANT : gardez la MEME valeur que lors du premier lancement (par defaut : stockfact)
POSTGRES_PASSWORD=stockfact
WEB_PORT=3000
# Lecture automatique des factures : renseignez UNE cle (sans espace ni guillemets)
# Gratuit : Groq (console.groq.com/keys)
GROQ_API_KEY= 
# Gratuit : Google Gemini (aistudio.google.com/apikey)
GEMINI_API_KEY=
# Payant : Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=
# Optionnel : forcer le fournisseur de lecture (groq, gemini ou anthropic)
SCAN_PROVIDER=
